# Node.js 22+, Python 3.12 and FFmpeg must be installed separately.
CUT_PORT=8770
CUT_DATA_DIR=./data
CUT_PYTHON=python3.12
# The base URL must include your provider's API prefix, for example /v1.
CUT_API_BASE_URL=https://api.openai.com/v1
CUT_API_KEY=
CUT_API_MODEL=
# schema: strict JSON Schema; json: JSON mode; prompt: plain JSON prompt.
CUT_API_FORMAT=schema
# Explicit LOCAL Whisper model directory. Model weights are not distributed.
CUT_WHISPER_MODEL=
